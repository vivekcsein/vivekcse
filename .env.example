# Committed, no secrets. Every variable below is read by the Zod schemas in
# src/packages/env/*.env.ts; anything not listed here is not used by the app.
#
# This is a STATIC EXPORT (output: "export"). Every NEXT_PUBLIC_* value is
# inlined into the public HTML/JS at build time, so never put a secret in
# here. There is no server, no API and no auth backend in this project.
#
# Local development: copy to .env.local.
# Production (GitHub Pages): you normally set NOTHING — the workflow derives
# NEXT_PUBLIC_SITE_URL from public/CNAME. To override anything, add it as a
# repository *variable* (Settings → Secrets and variables → Actions → Variables).
#
# REQUIRED in production: NEXT_PUBLIC_SITE_URL only (https, not localhost, and the
# host must equal public/CNAME). Everything else has a working default.
#
# A blank value counts as "not set". Lines starting with '#' are optional.

# --- Site ------------------------------------------------------------------
# REQUIRED in production: must be https and must NOT be localhost; the host must
# equal public/CNAME (https://vivekcse.xyz). The CI build fails otherwise
# (src/packages/scripts/secure-export.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_TITLE=Top 1% Full stack developer with AI
NEXT_PUBLIC_APP_NAME=vivekcsexyz
NEXT_PUBLIC_APP_VERSION=4.0.0
NEXT_PUBLIC_APP_DESCRIPTION=A portfolio full stack developer with a passion for building scalable and high-performance web applications.
NEXT_PUBLIC_LOGO_URL=/logo.png
# optional; app/opengraph-image generates one when empty
# NEXT_PUBLIC_OG_IMAGE_URL=
# Set to "true" only when deploying to https://<user>.github.io/vivekcsexyz
# (project page with a sub-path). Leave unset for a custom domain (CNAME).
# NEXT_PUBLIC_GH_PROJECT_PAGES=

# --- Look ------------------------------------------------------------------
# One of the theme names in src/packages/configs/styles.config.ts
NEXT_PUBLIC_ACTIVE_STYLE=cyantrix-theme
# system | light | dark
NEXT_PUBLIC_ACTIVE_THEME=system

# --- Author / social -------------------------------------------------------
NEXT_PUBLIC_AUTHOR_NAME=Vivek
NEXT_PUBLIC_AUTHOR_HANDLE=vivekcsein
# NEXT_PUBLIC_AUTHOR_EMAIL=
NEXT_PUBLIC_AUTHOR_QUOTE=Discipline turns ideas into results.
NEXT_PUBLIC_TWITTER=https://twitter.com/vivekcsein
NEXT_PUBLIC_GITHUB=https://github.com/vivekcsein
NEXT_PUBLIC_LINKEDIN=https://www.linkedin.com/showcase/vivekcsein

# --- Search Console --------------------------------------------------------
# Leave empty to omit the verification <meta> tag entirely.
# NEXT_PUBLIC_GOOGLE_VERIFICATION=

# --- Client origin (client.env.ts) -----------------------------------------
NEXT_PUBLIC_CLIENT_ORIGIN=http://localhost:7164
NEXT_PUBLIC_CLIENT_PREFIX=/app

# --- Demo user (user.env.ts) — placeholder data for UI previews only -------
NEXT_PUBLIC_DEFAULT_USER_ID=default-user-1
NEXT_PUBLIC_DEFAULT_USER_FULLNAME=John Doe
NEXT_PUBLIC_DEFAULT_USER_EMAIL=johndoe@gmail.com
# NEXT_PUBLIC_DEFAULT_USER_AVATAR_URL=
NEXT_PUBLIC_DEFAULT_USER_ROLE=USER
NEXT_PUBLIC_DEFAULT_USER_STATUS=INACTIVE

# --- Ads (ads.env.ts) — leave blank to keep ads (and their CSP hosts) off ---
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_RAIL=
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
